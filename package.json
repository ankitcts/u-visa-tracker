{
  "name": "u-visa-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--unhandled-rejections=warn' next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --forceExit",
    "test:unit": "jest src/__tests__/unit",
    "test:components": "jest src/__tests__/components",
    "test:integration": "jest src/__tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "fetch": "node scripts/fetch-uscis.mjs",
    "narrate": "node scripts/generate-narration.mjs",
    "archive": "node scripts/fetch-archive-clippings.mjs"
  },
  "dependencies": {
