NEXT_PUBLIC_SITE_URL=http://localhost:3000
# AdSense client ID. Format: ca-pub-XXXXXXXXXXXXXXXX (the publisher ID
# in public/ads.txt is the same number without the "ca-pub-" prefix).
NEXT_PUBLIC_ADSENSE_ID=ca-pub-6746391460508825
# Optional: enables the LLM news classifier on the home page + /integrity
# Uses claude-haiku-4-5 (fast, low cost). If unset, news renders unclassified.
ANTHROPIC_API_KEY=

# Required for /api/chat (U-Bot). Free key from https://console.groq.com
# Route is OpenAI-compatible — override base/model to swap providers.
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
